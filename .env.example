# Set this to the real public origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Application table names use the fixed ssinfo_ prefix (no extra variable needed).
# Leave DATABASE_* unset to keep the public website in standalone mode.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
# Generate separate random 32-byte hex values. Never use NEXT_PUBLIC_ for secrets.
ANALYTICS_HASH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
# Set only if the hosting reverse proxy overwrites these headers.
TRUSTED_IP_HEADER=
TRUSTED_COUNTRY_HEADER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# One-time CLI bootstrap only; remove ADMIN_PASSWORD after creating your admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
