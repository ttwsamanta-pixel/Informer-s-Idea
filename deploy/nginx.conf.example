# Optional self-managed VPS only; not required for Hostinger managed Node apps.
# Install a certificate before enabling this HTTPS server block.
server {
    listen 443 ssl;
    server_name informersidea.com;
    ssl_certificate /etc/letsencrypt/live/informersidea.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/informersidea.com/privkey.pem;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name informersidea.com;
    return 301 https://informersidea.com$request_uri;
}
